.env
.env.local
.env.*.local

# novel2all 项目元数据
.novel2all/cache/
.novel2all/memory.db
.novel2all/ci-status.json
.novel2all/ci-alerts.json
.ci_watch.pid
.ci_watch.log

# CI scripts 临时文件
scripts/__pycache__/

# 测试日志（来自 PowerShell / Out-File）
.test*.log
.test*.py
*.test.log
FINAL-*.log
.ssh-test.log
.outbound.log
.perms.log
.api-info.log
.api-test.log
.api-info.py
.token-check.py
.token-check.log
.github-info.log
.github-info.py
.push.py
.push-result.log
.push-verbose.log
.push-trace.log
.remote.log
.add.log
.add2.log
.commit.log
.status.log
.status2.log

# AI 助手诊断文件（用前缀下划线命名，例如 _commit_msg.txt）
_*.txt
_*.py

# 用户项目
# 用户用 novel2all 创建的小说项目目录由用户自己管理 .gitignore

# 注意：之前用 [a-z0-9]{8,12} 类规则想忽略 git 自身的"blat"占位文件，
# 但这类规则会误伤合法文件（如 pipeline.py 的"pipeline"8 字符 + .py）。
# 改为：彻底不忽略，由用户手动 `git status --ignored` 看到后清理，
# 或者用 scripts/clean-gitblat.py 脚本。

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store

# 临时暂存区（_clean.py 移出根目录临时文件到这里，确认无问题后可删）
.junk/
