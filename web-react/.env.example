# Vite 环境变量示例 (V1.5.1 Sprint 1)
#
# 复制此文件为 .env.local 并根据需要修改:
#   cp .env.example .env.local
#
# .env.local 中的变量会被 Vite 自动加载（优先级最高）。
# 修改后需要重启 `npm run dev` 才会生效。

# ============ 后端 API base URL ============
# 默认值: 'http://192.168.3.106:8000'（兼容现有本地开发环境）
# 生产 / 其他部署可通过此变量覆盖（Vite build-time 注入）：
#   - 同源部署：留空，浏览器走相对路径 + Nginx 反代
#   - 跨域部署：填 http://your-backend:8000
#   - HTTPS 生产：填 https://api.example.com
VITE_API_BASE_URL=http://192.168.3.106:8000

# ============ React Query 调试 ============
# 设为 1 启用 React Query Devtools 浮动按钮（仅 dev 模式）
# VITE_RQ_DEVTOOLS=1

# ============ Sentry / 监控（可选）============
# VITE_SENTRY_DSN=

# ============ Feature flags（可选）============
# VITE_FEATURE_DARK_MODE=1