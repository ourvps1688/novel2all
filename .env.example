# novel2all 环境变量示例
# 复制为 .env 后填入真实值

# ===== LLM API Keys =====
# 至少填一个
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# ===== 模型选择 =====
# 默认模型（claude-sonnet 推荐用于写作，haiku 用于提取）
NOVEL2ALL_MODEL=claude-sonnet-4-20250514

# 默认 fallback
NOVEL2ALL_FALLBACK_MODEL=deepseek-chat

# ===== 项目路径 =====
# 当前项目根目录（默认 cwd）
NOVEL2ALL_PROJECT=.

# ===== Web UI =====
NOVEL2ALL_WEB_HOST=127.0.0.1
NOVEL2ALL_WEB_PORT=8765

# ===== Advanced =====
# 重试次数
NOVEL2ALL_MAX_RETRIES=3
# 请求超时
NOVEL2ALL_TIMEOUT_SECONDS=120
